# ──────────────────────────────────────────────────────────────
# NeuroStack — Environment Variables Template
# Copy this file:  cp .env.example backend/.env
# Then edit the values below to match your environment.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
PROJECT_NAME="NeuroStack API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:4173", "http://localhost:3000", "http://localhost:80", "http://localhost"]'

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=neurostack
POSTGRES_PORT=5432

# ── JWT Authentication ────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Bhashini Translation API (Indian Gov) ────────────────────
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_PIPELINE_ID=your-pipeline-id
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TTS_AUTH_TOKEN=your-tts-auth-token

# ── Ollama (Local LLM) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# ── vLLM (Optional — GPU Inference Server) ────────────────────
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_TOKEN=your-huggingface-token

# ── Docker-specific overrides (used by docker-compose) ────────
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
